---
import '../styles/global.css';
import { url } from '../lib/url';
import { DEFAULT_BRAND } from '../data/brands';

interface Props {
  title?: string;
  description?: string;
}

const SITE = 'Event Shot Lists';
const { title, description = 'Coverage plans, example shots, and plain-language camera settings for event media volunteers.' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE}` : SITE;

const nav = [
  { href: 'events/', label: 'Events' },
  { href: 'murti/', label: 'Murti' },
  { href: 'photo-settings/', label: 'Photo' },
  { href: 'video-settings/', label: 'Video' },
];
const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(url(href));
---

<!doctype html>
<html lang="en" data-brand={DEFAULT_BRAND}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <!-- Apply the saved camera brand before paint so the page doesn't flash. -->
    <script is:inline>
      try {
        var b = localStorage.getItem('esl-brand');
        if (b === 'sony' || b === 'canon' || b === 'nikon') document.documentElement.dataset.brand = b;
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-surface focus:px-4 focus:py-2 focus:border focus:border-line"
      >Skip to content</a
    >

    <header class="no-print border-b border-line bg-surface">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
        <a href={url()} class="py-3 sm:py-4 text-base font-semibold text-ink no-underline hover:no-underline hover:text-ink">
          Event Shot Lists
        </a>
        <nav aria-label="Main" class="-mx-1 sm:mx-0">
          <ul class="grid grid-cols-4 sm:flex sm:gap-1">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={url(item.href)}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'flex min-h-11 items-center justify-center px-3 text-sm font-medium no-underline border-b-2 hover:no-underline',
                      isActive(item.href)
                        ? 'border-accent text-ink'
                        : 'border-transparent text-ink-soft hover:text-ink hover:border-line-strong',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1 mx-auto w-full max-w-5xl px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>

    <footer class="no-print border-t border-line">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 py-6 text-sm text-ink-soft flex flex-wrap gap-x-6 gap-y-2">
        <span>Event Shot Lists</span>
        <a href={url('quick-reference/')}>Printable quick reference</a>
      </div>
    </footer>
  </body>
</html>
