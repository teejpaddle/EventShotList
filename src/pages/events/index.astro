---
import Base from '../../layouts/Base.astro';
import CoverageBadge from '../../components/CoverageBadge.astro';
import { ChevronRight } from '@lucide/astro';
import { events, SEASONS, formatStaffList } from '../../data/events';
import { url } from '../../lib/url';

const bySeason = SEASONS.map((season) => ({ season, items: events.filter((e) => e.season === season) }));
---

<Base title="Events" description="All events by season, with coverage type and recommended staffing.">
  <h1 class="text-3xl font-semibold sm:text-4xl">Events</h1>

  <div class="mt-8 space-y-10">
    {
      bySeason.map(({ season, items }) => (
        <section aria-labelledby={`season-${season}`}>
          <h2 id={`season-${season}`} class="border-b border-line pb-2 text-sm font-semibold uppercase tracking-wider text-ink-soft">
            {season}
          </h2>
          <ul class="divide-y divide-line">
            {items.map((e) => (
              <li>
                <a
                  href={url(`events/${e.slug}/`)}
                  class="group flex items-center gap-3 py-4 no-underline text-ink hover:no-underline hover:text-ink hover:bg-surface -mx-2 px-2 rounded-sm"
                >
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                      <span class="font-semibold group-hover:text-accent-ink group-hover:underline">{e.name}</span>
                      <CoverageBadge coverage={e.coverage} />
                    </div>
                    <dl class="mt-1.5 grid gap-0.5 text-sm text-ink-soft sm:grid-cols-[6rem_1fr]">
                      <dt class="font-medium text-ink">Photo</dt>
                      <dd>{formatStaffList(e.photo)}</dd>
                      {e.video.length > 0 && (
                        <>
                          <dt class="font-medium text-ink">Video</dt>
                          <dd>{formatStaffList(e.video)}</dd>
                        </>
                      )}
                    </dl>
                  </div>
                  <ChevronRight size={20} class="shrink-0 text-ink-soft" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
