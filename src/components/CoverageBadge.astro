---
import { Camera, Video } from '@lucide/astro';
import type { Coverage } from '../data/events';

interface Props { coverage: Coverage; }
const { coverage } = Astro.props;
const withVideo = coverage === 'Photo & Video';
---
<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-sm border px-2 py-0.5 text-xs font-medium whitespace-nowrap',
    withVideo ? 'border-accent/30 bg-accent-soft text-accent-ink' : 'border-line bg-muted text-ink-soft',
  ]}
>
  {withVideo ? <Video size={14} aria-hidden="true" /> : <Camera size={14} aria-hidden="true" />}
  {coverage}
</span>
