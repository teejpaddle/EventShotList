---
import Base from '../../layouts/Base.astro';
import { ChevronRight } from '@lucide/astro';
import { brands } from '../../data/brands';
import { url } from '../../lib/url';
---
<Base title="Quick Reference" description="One printable page of starting settings per camera brand.">
  <h1 class="text-3xl font-semibold sm:text-4xl">Quick Reference</h1>
  <p class="mt-3 max-w-prose text-ink-soft">One page of starting settings for your camera brand. Print it or take a screenshot before the event.</p>
  <ul class="mt-8 grid gap-3 sm:grid-cols-3">
    {brands.map((b) => (
      <li>
        <a href={url(`quick-reference/${b.id}/`)} class="group flex min-h-16 items-center justify-between rounded-md border border-line bg-surface p-5 text-lg font-semibold text-ink no-underline hover:border-accent hover:text-ink hover:no-underline">
          {b.name}
          <ChevronRight size={18} class="text-ink-soft group-hover:text-accent" aria-hidden="true" />
        </a>
      </li>
    ))}
  </ul>
</Base>
