---
import type { Staff } from '../data/events';

interface Props { title: string; staff: Staff[]; empty: string; }
const { title, staff, empty } = Astro.props;
const total = staff.reduce((n, s) => n + s.count, 0);
---
<div class="rounded-md border border-line bg-surface p-4 sm:p-5">
  <h3 class="text-base font-semibold flex items-baseline justify-between gap-2">
    {title}
    {total > 0 && <span class="text-sm font-normal text-ink-soft">{total} {total === 1 ? 'person' : 'people'}</span>}
  </h3>
  {staff.length === 0 ? (
    <p class="mt-3 text-sm text-ink-soft">{empty}</p>
  ) : (
    <ul class="mt-3 divide-y divide-line">
      {staff.map((s) => (
        <li class="flex items-baseline justify-between gap-3 py-2 text-sm">
          <span><span class="font-semibold">{s.count} × {s.side}</span></span>
          <span class="text-ink-soft text-right">{s.roles.length ? s.roles.join(' & ') : 'No role specified'}</span>
        </li>
      ))}
    </ul>
  )}
</div>
